    f"Price = {model.intercept_:.2f} "
    f"+ ({model.coef_[0]:.2f} * Size_sqft) "
    f"+ ({model.coef_[1]:.2f} * Bedrooms) "
    f"+ ({model.coef_[2]:.2f} * Bathrooms) "
    f"+ ({model.coef_[3]:.2f} * Distance_km)"
)

