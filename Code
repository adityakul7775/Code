import numpy as np
from scipy.stats import f as f_dist

def f_test_variances(sample1, sample2, alpha=0.05):
    s1 = np.asarray(sample1, dtype=float)
    s2 = np.asarray(sample2, dtype=float)

    var1 = s1.var(ddof=1)
    var2 = s2.var(ddof=1)

    n1 = len(s1)
    n2 = len(s2)

    # Put the larger variance in the numerator
    if var1 >= var2:
        F = var1 / var2
        df1, df2 = n1 - 1, n2 - 1
    else:
        F = var2 / var1
        df1, df2 = n2 - 1, n1 - 1

    p_value = 2 * min(
        f_dist.cdf(F, df1, df2),
        1 - f_dist.cdf(F, df1, df2)
    )

    critical_value = f_dist.ppf(1 - alpha / 2, df1, df2)
    reject = F > critical_value

    return {
        "Variance 1": round(var1, 4),
        "Variance 2": round(var2, 4),
        "F-statistic": round(F, 4),
        "df1, df2": (df1, df2),
        "Critical F": round(critical_value, 4),
        "p-value": round(p_value, 6),
        "Conclusion": "Reject H0 (variances differ)" if reject
                      else "Fail to reject H0 (insufficient evidence of difference)"
    }


machine_A = [10.0, 10.1, 9.9, 10.2, 9.8]
machine_B = [10.0, 9.9, 10.1, 9.8, 10.2]

result = f_test_variances(machine_A, machine_B, alpha=0.05)
for k, v in result.items():
    print(f"{k:22s}: {v}")


