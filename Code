def Cal_Eigenvalue(Matrix):
    a = Matrix[0][0]
    b = Matrix[0][1]
    c = Matrix[1][0]
    d = Matrix[1][1]

    trace = a + d
    det = a * d - b * c
    disc = trace**2 - 4 * det

    if disc < 0:
        print("Eigen values are complex")
        return None

    sqrt_disc = disc**0.5
    lamb1 = (trace + sqrt_disc) / 2
    lamb2 = (trace - sqrt_disc) / 2

    def Eigenvector(lam):
        if b != 0:
            v = (lam - a) / b
            return [1, v]
        elif c != 0:
            v = [lam - d, c]
            return v
        else:
            return [1, 0]

    eigen_vector1 = Eigenvector(lamb1)
    eigen_vector2 = Eigenvector(lamb2)

    return [lamb1, lamb2], [eigen_vector1, eigen_vector2]


