# PRACTICAL 5: GAUSSIAN ELIMINATION
# ============================================================

def gaussian_elimination(A, b):
    n = len(b)

    # Forward elimination
    for i in range(n):
        pivot = A[i][i]

        for j in range(i, n):
            A[i][j] = A[i][j] / pivot
        b[i] = b[i] / pivot

        for k in range(i + 1, n):
            factor = A[k][i]
            for j in range(i, n):
                A[k][j] = A[k][j] - factor * A[i][j]
            b[k] = b[k] - factor * b[i]

    # Back substitution
    x = [0.0] * n
    for i in range(n - 1, -1, -1):
        x[i] = b[i]
        for j in range(i + 1, n):
            x[i] = x[i] - A[i][j] * x[j]

    return x


