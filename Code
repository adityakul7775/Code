import numpy as np
import matplotlib.pyplot as plt

def lagrange_interpolation(x_points, y_points, x_val):
    n = len(x_points)
    result = 0.0

    for i in range(n):
        term = y_points[i]

        for j in range(n):
            if i != j:
                term *= (
                    (x_val - x_points[j]) /
                    (x_points[i] - x_points[j])
                )

        result += term

    return result


x = np.array([1, 2, 3, 4, 5], dtype=float)
y = np.array([2, 4, 1, 3, 7], dtype=float)

