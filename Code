import numpy as np
import matplotlib.pyplot as plt

def divided_diff(x, y):
    n = len(x)
    table = np.zeros((n, n))
    table[:, 0] = y

    for j in range(1, n):
        for i in range(n - j):
            table[i][j] = (
                table[i + 1][j - 1] - table[i][j - 1]
            ) / (x[i + j] - x[i])

    return table


def newton_interpolation(x, table, value):
    n = len(x)
    result = table[0][0]
    product = 1.0

    for i in range(1, n):
        product *= (value - x[i - 1])
        result += table[0][i] * product

    return result


x = np.array([1, 2, 3, 4], dtype=float)
y = np.array([1, 4, 9, 16], dtype=float)

n = len(x)
table = divided_diff(x, y)

print("Divided-difference table:")
for i in range(n):
    row = [
        f"{table[i][j]:.4f}" if j < n - i else "0.0000"
        for j in range(n)
    ]
    print(row)

value = 2.5
result = newton_interpolation(x, table, value)

print(f"\nInterpolated value at x = {value} is {result:.4f}")
print(f"Exact x^2 value is {value**2:.2f}")

x_plot = np.linspace(min(x), max(x), 100)
y_plot = [
    newton_interpolation(x, table, val)
    for val in x_plot
]

plt.plot(x, y, "ro", label="Known data points")
plt.plot(x_plot, y_plot, color="purple",
         label="Newton interpolation curve")
plt.scatter(value, result, color="green", marker="x",
            s=100, linewidths=2,
            label=f"Interpolated point (x={value})")

plt.title("Newton's Divided-Difference Interpolation")
plt.xlabel("x")
plt.ylabel("y")
plt.legend()
plt.grid(alpha=0.3)
plt.show()


